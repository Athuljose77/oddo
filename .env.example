# Copy to .env — NEVER commit .env (repo is public)
# Database (Supabase connection string in deployed env; local dev falls back to SQLite)
DATABASE_URL=sqlite:///./dev.db

# Auth
JWT_SECRET=generate-a-long-random-string
JWT_ACCESS_MINUTES=60
ADMIN_EMAIL=admin@brightloop.io
ADMIN_PASSWORD=Change!MeAdmin123

# App
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
DEFAULT_CURRENCY=INR
BILLING_TZ=Asia/Kolkata

# Mailer: log = reset links printed to backend logs (demo), smtp = real email
MAILER_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@brightloop.local

# Billing engine
STALE_RUN_MINUTES=15
MAX_CATCHUP_PERIODS=366
ALLOW_OVERPAYMENT=false

# Odoo integration — disabled until organizers confirm access
ODOO_ENABLED=false
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_PROTOCOL=auto
